// Nordic nRF5340 DK (PCA10095) — nRF5340, Dual CM33
// Application core 128 MHz, Network core 64 MHz
// 1 MB + 256 KB Flash, 512 KB + 64 KB RAM
// 4 LEDs (P0.28-P0.31), 4 buttons (P0.23-P0.26)

using "platforms/cpus/nordic/nrf5340.repl"

gpio0:
    28 -> led0@0
    29 -> led1@0
    30 -> led2@0
    31 -> led3@0

led0: Miscellaneous.LED @ gpio0 28
    invert: true

led1: Miscellaneous.LED @ gpio0 29
    invert: true

led2: Miscellaneous.LED @ gpio0 30
    invert: true

led3: Miscellaneous.LED @ gpio0 31
    invert: true

sw0: Miscellaneous.Button @ gpio0 23
    -> gpio0@23

sw1: Miscellaneous.Button @ gpio0 24
    -> gpio0@24

sw2: Miscellaneous.Button @ gpio0 25
    -> gpio0@25

sw3: Miscellaneous.Button @ gpio0 26
    -> gpio0@26
