// Nucleo-F303RE — STM32F303RET6, Cortex-M4F @ 72 MHz
// 512 KB Flash, 80 KB SRAM, mixed-signal
// User LED (LD2) on PA5, User button (B1) on PC13

using "platforms/cpus/st/stm32f303.repl"

gpioPortA:
    5 -> userLed@0

userLed: Miscellaneous.LED @ gpioPortA 5

userButton: Miscellaneous.Button @ gpioPortC
    -> gpioPortC@13
