// ST Nucleo-G474RE — STM32G474RET6, Cortex-M4F @ 170 MHz
// 512 KB Flash, 128 KB SRAM
// User LED (LD2) on PA5, User button (B1) on PC13

using "platforms/cpus/st/stm32g474.repl"

gpioPortA:
    5 -> userLed@0

userLed: Miscellaneous.LED @ gpioPortA 5

userButton: Miscellaneous.Button @ gpioPortC
    -> gpioPortC@13
