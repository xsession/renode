// Adafruit Feather M4 Express — ATSAMD51J19A, Cortex-M4F @ 120 MHz
// 512 KB Flash, 192 KB SRAM, 2 MB external QSPI flash
// NeoPixel (GPIO/PA15=D8), Red LED (PA23/D13)
// Feather form factor, LiPo charger, USB-C

using "platforms/cpus/microchip/atsame51j20a.repl"

// Adafruit Feather M4 uses SAMD51J19A (512 KB flash) vs SAME51J20A (1 MB)
// Override flash to match actual chip
flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x80000           // 512 KB

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x30000           // 192 KB

// External QSPI flash (GD25Q16C or similar)
qspiFlash: Memory.MappedMemory @ sysbus 0x04000000
    size: 0x200000          // 2 MB
