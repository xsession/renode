// Raspberry Pi RP2350 — Dual Cortex-M33 @ 150 MHz (or dual RISC-V Hazard3)
// 520 KB SRAM, no internal flash (XIP from external QSPI)
// Reference: RP2350 Datasheet (Raspberry Pi Ltd.)
//
// Memory map:
//   0x00000000  ROM (32 KB boot ROM)
//   0x10000000  XIP (external flash via QSPI — up to 16 MB)
//   0x20000000  SRAM (520 KB total, 10 × 16 KB banks)
//   0x40000000  APB peripherals
//   0x50000000  AHB-Lite peripherals
//   0xD0000000  SIO
//   0xE0000000  ARM PPB

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic0

nvic0: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu0@0

rom: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x8000

flash: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x400000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x82000

// ---- UART0 ----
uart0: UART.RP2040_UART @ sysbus <0x40070000, +0x1000>
    -> nvic0@33

// ---- UART1 ----
uart1: UART.RP2040_UART @ sysbus <0x40078000, +0x1000>
    -> nvic0@34

// ---- SPI0 ----
spi0: SPI.RP2040_SPI @ sysbus <0x40080000, +0x1000>
    -> nvic0@31

// ---- SPI1 ----
spi1: SPI.RP2040_SPI @ sysbus <0x40088000, +0x1000>
    -> nvic0@32

// ---- I2C0 ----
i2c0: I2C.RP2040_I2C @ sysbus <0x40090000, +0x1000>
    -> nvic0@35

// ---- I2C1 ----
i2c1: I2C.RP2040_I2C @ sysbus <0x40098000, +0x1000>
    -> nvic0@36

// ---- ADC ----
adc: Analog.RP2040_ADC @ sysbus <0x400A0000, +0x1000>
    -> nvic0@37

// ---- PWM (12 slices) ----
pwm: Timers.RP2040_PWM @ sysbus <0x400A8000, +0x1000>
    -> nvic0@4

// ---- System Timer ----
timer0: Timers.RP2040_Timer @ sysbus <0x400B0000, +0x1000>
    -> nvic0@0

// ---- Watchdog ----
watchdog: Timers.RP2040_Watchdog @ sysbus <0x400D8000, +0x1000>
    -> nvic0@0

// ---- GPIO (SIO-side, 48 pins) ----
gpio: GPIOPort.RP2040_GPIO @ sysbus <0xD0000000, +0x1000>
    numberOfPins: 48

// ---- DMA ----
dma: DMA.RP2040_DMA @ sysbus <0x50000000, +0x1000>
    IRQ0 -> nvic0@11
    IRQ1 -> nvic0@12

// ---- PIO0 ----
pio0: Miscellaneous.RP2040_PIO @ sysbus <0x50200000, +0x1000>
    -> nvic0@7

// ---- PIO1 ----
pio1: Miscellaneous.RP2040_PIO @ sysbus <0x50300000, +0x1000>
    -> nvic0@9

// ---- PIO2 ----
pio2: Miscellaneous.RP2040_PIO @ sysbus <0x50400000, +0x1000>
    -> nvic0@11

// ---- SSI (QSPI) ----
ssi: SPI.RP2040_SSI @ sysbus <0x400D0000, +0x1000>
    -> nvic0@6
