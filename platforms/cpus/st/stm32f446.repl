// STM32F446 — Cortex-M4F, 180 MHz, 512 KB Flash, 128 KB SRAM
// Reference: RM0390, STM32F446 Reference Manual
using "./stm32f4.repl"

cpu:
    cpuType: "cortex-m4f"

nvic:
    systickFrequency: 180000000

flash:
    size: 0x80000

sram:
    size: 0x20000

usart6: UART.STM32_UART @ sysbus <0x40011400, +0x100>
    -> nvic@71

spi4: SPI.STM32SPI @ sysbus 0x40013400
    IRQ -> nvic@84
