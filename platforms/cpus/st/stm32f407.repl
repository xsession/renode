// STM32F407 — Cortex-M4F, 168 MHz, 1 MB Flash, 192 KB SRAM
// Reference: RM0090, STM32F407 Reference Manual
using "./stm32f4.repl"

cpu:
    cpuType: "cortex-m4f"

nvic:
    systickFrequency: 168000000

flash:
    size: 0x100000

sram:
    size: 0x30000

usart6: UART.STM32_UART @ sysbus <0x40011400, +0x100>
    -> nvic@71

sysbus:
    init:
        ApplySVD @https://dl.antmicro.com/projects/renode/svd/STM32F407.svd.gz
