// STM32H563 — Cortex-M33, 250 MHz, 2 MB Flash, 640 KB SRAM
// Reference: RM0481, STM32H563 Reference Manual
// High-performance H5 series with TrustZone
//
// Memory map:
//   0x08000000  Flash (2 MB)
//   0x20000000  SRAM1 (256 KB)
//   0x20040000  SRAM2 (64 KB)
//   0x20050000  SRAM3 (320 KB)
//   0x30000000  Backup SRAM (4 KB)

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000

sram1: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

sram2: Memory.MappedMemory @ sysbus 0x20040000
    size: 0x10000

sram3: Memory.MappedMemory @ sysbus 0x20050000
    size: 0x50000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 250000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

exti: IRQControllers.STM32H7_EXTI @ sysbus 0x44022000
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 250000000
    IRQ -> nvic@58

usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 250000000
    IRQ -> nvic@59

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 250000000
    IRQ -> nvic@60

uart4: UART.STM32F7_USART @ sysbus 0x40004C00
    frequency: 250000000
    IRQ -> nvic@61

uart5: UART.STM32F7_USART @ sysbus 0x40005000
    frequency: 250000000
    IRQ -> nvic@62

usart6: UART.STM32F7_USART @ sysbus 0x40011400
    frequency: 250000000
    IRQ -> nvic@63

lpuart1: UART.STM32F7_USART @ sysbus 0x44002400
    frequency: 250000000
    IRQ -> nvic@64

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>
    modeResetValue: 0xABFFFFFF
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x42020C00, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x42021000, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x42021400, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x42021C00, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortI: GPIOPort.STM32_GPIOPort @ sysbus <0x42022000, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

spi1: SPI.STM32SPI @ sysbus 0x40013000
    IRQ -> nvic@35

spi2: SPI.STM32SPI @ sysbus 0x40003800
    IRQ -> nvic@36

spi3: SPI.STM32SPI @ sysbus 0x40003C00
    IRQ -> nvic@51

i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@33
    ErrorInterrupt -> nvic@34

i2c3: I2C.STM32F7_I2C @ sysbus 0x44002800
    EventInterrupt -> nvic@72
    ErrorInterrupt -> nvic@73

i2c4: I2C.STM32F7_I2C @ sysbus 0x44002C00
    EventInterrupt -> nvic@93
    ErrorInterrupt -> nvic@94

can1: CAN.STMCAN @ sysbus <0x4000A400, +0x400>
    [0-3] -> nvic@[19-22]

timer1: Timers.STM32_Timer @ sysbus 0x40012C00
    frequency: 10000000
    initialLimit: 0xFFFF

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    -> nvic@28
    frequency: 10000000
    initialLimit: 0xFFFFFFFF

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    -> nvic@29
    frequency: 10000000
    initialLimit: 0xFFFF

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    -> nvic@30
    frequency: 10000000
    initialLimit: 0xFFFF

timer5: Timers.STM32_Timer @ sysbus 0x40000C00
    -> nvic@50
    frequency: 10000000
    initialLimit: 0xFFFFFFFF

timer6: Timers.STM32_Timer @ sysbus 0x40001000
    -> nvic@54
    frequency: 10000000
    initialLimit: 0xFFFF

timer7: Timers.STM32_Timer @ sysbus 0x40001400
    -> nvic@55
    frequency: 10000000
    initialLimit: 0xFFFF

timer8: Timers.STM32_Timer @ sysbus 0x40013400
    frequency: 10000000
    initialLimit: 0xFFFF

dma1: DMA.STM32LDMA @ sysbus 0x40020000
    [0-7] -> nvic@[11-17, 47]

dma2: DMA.STM32LDMA @ sysbus 0x40020400
    [0-7] -> nvic@[56-60, 68-70]

rng: Miscellaneous.STM32F4_RNG @ sysbus 0x520C0800
    -> nvic@80

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 32000
    windowOption: true
    defaultPrescaler: 0x4

rtc: Timers.STM32F4_RTC @ sysbus 0x44007800
    AlarmIRQ -> nvic@41
