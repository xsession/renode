// NXP LPC845 — Cortex-M0+, 30 MHz, 64 KB Flash, 16 KB SRAM
// Reference: UM11029, LPC84x User Manual
// Low-cost with capacitive touch, I2C-bus, DAC
//
// Memory map:
//   0x00000000  Flash (64 KB)
//   0x10000000  SRAM (16 KB)

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 30000000
    IRQ -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x10000

sram: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x4000

usart0: UART.LPC_UART @ sysbus <0x40064000, +0x1000>
    -> nvic@8

usart1: UART.LPC_UART @ sysbus <0x40068000, +0x1000>
    -> nvic@9

usart2: UART.LPC_UART @ sysbus <0x4006C000, +0x1000>
    -> nvic@10

usart3: UART.LPC_UART @ sysbus <0x40070000, +0x1000>
    -> nvic@11

usart4: UART.LPC_UART @ sysbus <0x40074000, +0x1000>
    -> nvic@12

spi0: SPI.LPC_SPI @ sysbus 0x40058000
    -> nvic@0

spi1: SPI.LPC_SPI @ sysbus 0x4005C000
    -> nvic@1

i2c0: I2C.LPC_I2C @ sysbus 0x40050000
    -> nvic@4

i2c1: I2C.LPC_I2C @ sysbus 0x40054000
    -> nvic@7

i2c2: I2C.LPC_I2C @ sysbus 0x40030000
    -> nvic@21

i2c3: I2C.LPC_I2C @ sysbus 0x40034000
    -> nvic@22
