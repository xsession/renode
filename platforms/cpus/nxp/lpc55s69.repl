// NXP LPC55S69 — Dual Cortex-M33, 150 MHz, 640 KB Flash, 320 KB SRAM
// Reference: UM11126, LPC55S6x User Manual
// TrustZone, USB HS, Hardware crypto
//
// Memory map:
//   0x00000000  Flash (640 KB, dual-bank)
//   0x04000000  Flash (alias bank B)
//   0x20000000  SRAM0 (64 KB)
//   0x20010000  SRAM1 (64 KB)
//   0x20020000  SRAM2 (64 KB)
//   0x20030000  SRAM3 (64 KB)
//   0x20040000  SRAMX (32 KB, code execution)
//   0x40000000  APB peripherals

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic0

nvic0: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 150000000
    -> cpu0@0

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0xA0000

sram0: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x10000

sram1: Memory.MappedMemory @ sysbus 0x20010000
    size: 0x10000

sram2: Memory.MappedMemory @ sysbus 0x20020000
    size: 0x10000

sram3: Memory.MappedMemory @ sysbus 0x20030000
    size: 0x10000

sramx: Memory.MappedMemory @ sysbus 0x04000000
    size: 0x8000

usart0: UART.LPC_UART @ sysbus <0x40086000, +0x1000>
    -> nvic0@14

usart1: UART.LPC_UART @ sysbus <0x40087000, +0x1000>
    -> nvic0@15

usart2: UART.LPC_UART @ sysbus <0x40088000, +0x1000>
    -> nvic0@16

usart3: UART.LPC_UART @ sysbus <0x40089000, +0x1000>
    -> nvic0@17

usart4: UART.LPC_UART @ sysbus <0x4008A000, +0x1000>
    -> nvic0@18

usart5: UART.LPC_UART @ sysbus <0x40096000, +0x1000>
    -> nvic0@19

usart6: UART.LPC_UART @ sysbus <0x40097000, +0x1000>
    -> nvic0@20

usart7: UART.LPC_UART @ sysbus <0x40098000, +0x1000>
    -> nvic0@21

// LPC55S69 Flexcomm: each block is muxed UART/SPI/I2C at the same address.
// Only USART models registered below. To use SPI or I2C on a given Flexcomm,
// replace the usartN entry with the desired peripheral type.

spi8: SPI.LPC_SPI @ sysbus 0x4009F000
    -> nvic0@22

timer0: Timers.LPC_Timer @ sysbus <0x40028000, +0x80>
    -> nvic0@10

timer1: Timers.LPC_Timer @ sysbus <0x40029000, +0x80>
    -> nvic0@11

timer2: Timers.LPC_Timer @ sysbus <0x4002A000, +0x80>
    -> nvic0@12

timer3: Timers.LPC_Timer @ sysbus <0x4002B000, +0x80>
    -> nvic0@13

timer4: Timers.LPC_Timer @ sysbus <0x4002C000, +0x80>
    -> nvic0@39
