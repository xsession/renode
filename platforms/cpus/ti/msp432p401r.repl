// TI MSP432P401R — Cortex-M4F, 48 MHz, 256 KB Flash, 64 KB SRAM
// Reference: SLAU356, MSP432P401R Technical Reference Manual
// Low-power MCU with 14-bit ADC
//
// Memory map:
//   0x00000000  Flash (256 KB)
//   0x00200000  Info Flash (16 KB)
//   0x01000000  SRAM (64 KB)
//   0x20000000  SRAM alias (bitband)
//   0x40000000  Peripherals

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xE0
    systickFrequency: 48000000
    IRQ -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x40000

info_flash: Memory.MappedMemory @ sysbus 0x00200000
    size: 0x4000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x10000

usart_a0: UART.PL011 @ sysbus <0x40001000, +0x100>
    -> nvic@16

usart_a1: UART.PL011 @ sysbus <0x40001400, +0x100>
    -> nvic@17

usart_a2: UART.PL011 @ sysbus <0x40001800, +0x100>
    -> nvic@18

usart_a3: UART.PL011 @ sysbus <0x40001C00, +0x100>
    -> nvic@19

spi_b0: SPI.Kinetis_SPI @ sysbus 0x40002000
    -> nvic@20

spi_b1: SPI.Kinetis_SPI @ sysbus 0x40002400
    -> nvic@21

spi_b2: SPI.Kinetis_SPI @ sysbus 0x40002800
    -> nvic@22

spi_b3: SPI.Kinetis_SPI @ sysbus 0x40002C00
    -> nvic@23
