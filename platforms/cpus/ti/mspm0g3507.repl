// MSPM0G3507 platform description
// Texas Instruments MSPM0G3507 — Cortex-M0+ @ 80 MHz
// 128 KB Flash, 32 KB SRAM, 12-bit ADC (4 MSPS), 2× CAN-FD (MCAN)
// MSPM0G series — high-performance M0+ with analog integration
// Reference: SLAU873, MSPM0 G-Series Technical Reference Manual
//
// Memory map:
//   0x00000000  Flash (128 KB)
//   0x20000000  SRAM (32 KB)
//   0x20200000  Factory / trim region
//   0x40000000+ Peripheral region

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic
    init:
        PerformanceInMips 80

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 80000000
    -> cpu@0

// ---- Memory ----
flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x20000           // 128 KB

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x8000            // 32 KB

// Factory config / trim
factoryRegion: Memory.MappedMemory @ sysbus 0x41C40000
    size: 0x1000

// ---- UART (4 instances) ----
uart0: UART.PL011 @ sysbus 0x40108000
    -> nvic@15

uart1: UART.PL011 @ sysbus 0x40100000
    -> nvic@16

uart2: UART.PL011 @ sysbus 0x40102000
    -> nvic@14

uart3: UART.PL011 @ sysbus 0x40104000
    -> nvic@17

// ---- SPI (2 instances) ----
spi0: SPI.STM32SPI @ sysbus 0x40468000
    IRQ -> nvic@1

spi1: SPI.STM32SPI @ sysbus 0x4046A000
    IRQ -> nvic@2

// ---- I2C (2 instances) ----
i2c0: I2C.STM32F7_I2C @ sysbus 0x400F0000
    EventInterrupt -> nvic@0

i2c1: I2C.STM32F7_I2C @ sysbus 0x400F2000
    EventInterrupt -> nvic@3

// ---- Timers ----
timer0: Timers.STM32_Timer @ sysbus 0x40860000
    frequency: 80000000
    initialLimit: 0xFFFF
    -> nvic@4

timer1: Timers.STM32_Timer @ sysbus 0x40862000
    frequency: 80000000
    initialLimit: 0xFFFF
    -> nvic@5

timer2: Timers.STM32_Timer @ sysbus 0x40864000
    frequency: 80000000
    initialLimit: 0xFFFF
    -> nvic@6

timer3: Timers.STM32_Timer @ sysbus 0x40866000
    frequency: 80000000
    initialLimit: 0xFFFF
    -> nvic@7

// ---- GPIO ----
gpioA: GPIOPort.STM32_GPIOPort @ sysbus <0x400A0000, +0x100>
    numberOfAFs: 16
    [0-31] -> nvic@8

gpioB: GPIOPort.STM32_GPIOPort @ sysbus <0x400A2000, +0x100>
    numberOfAFs: 16
    [0-31] -> nvic@9

sysbus:
    init:
        Tag <0x40420000 0x2000> "SYSCTL"
        Tag <0x40430000 0x1000> "VREF"
        Tag <0x40440000 0x2000> "COMP0"
        Tag <0x40442000 0x2000> "COMP1"
        Tag <0x40500000 0x4000> "ADC0"
        Tag <0x40502000 0x4000> "ADC1"
        Tag <0x40504000 0x1000> "DAC0"
        Tag <0x40506000 0x1000> "GPAMP"
        Tag <0x40580000 0x2000> "MCAN0"
        Tag <0x40582000 0x2000> "MCAN1"
        Tag <0x40800000 0x2000> "DMA"
        Tag <0x400C0000 0x2000> "CRC"
        Tag <0x400D0000 0x2000> "AES"
        Tag <0x400E0000 0x2000> "TRNG"
        Tag <0x40880000 0x2000> "RTC"
        Tag <0x40080000 0x2000> "WWDT0"
        Tag <0x40082000 0x2000> "WWDT1"
