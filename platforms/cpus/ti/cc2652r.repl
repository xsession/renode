// TI CC2652R — Cortex-M4F, 48 MHz, 352 KB Flash, 80 KB SRAM
// Reference: SWCU185, CC26x2/CC13x2 Technical Reference Manual
// Multi-protocol wireless MCU: Bluetooth 5.1, Thread, Zigbee, 802.15.4
//
// Memory map:
//   0x00000000  Flash (352 KB)
//   0x20000000  SRAM (80 KB)
//   0x10000000  ROM (boot + TI-BIOS)
//   0x40000000  Peripherals

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xE0
    systickFrequency: 48000000
    IRQ -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x58000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x14000

rom: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x20000

uart0: UART.PL011 @ sysbus <0x40001000, +0x1000>
    -> nvic@5

uart1: UART.PL011 @ sysbus <0x4000B000, +0x1000>
    -> nvic@36

spi0: SPI.Kinetis_SPI @ sysbus 0x40000000
    -> nvic@7

i2c0: I2C.STM32F1_I2C @ sysbus 0x40002000
    EventInterrupt -> nvic@1
    ErrorInterrupt -> nvic@1
