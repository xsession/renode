// MSP430FR5994 platform description
// Texas Instruments MSP430FR5994 — MSP430X (16/20-bit), 16 MHz
// 256 KB FRAM, 8 KB SRAM, low-energy accelerator (LEA)
// Reference: SLASE54, MSP430FR5994 Datasheet
//
// Memory map:
//   0x1C00–0x3BFF  SRAM (8 KB)
//   0x4000–0x43FFF FRAM (256 KB: 0x4000–0x43FFF)
//   0x1800–0x19FF  Information FRAM (512 B)

cpu: CPU.MSP430X @ sysbus
    cpuType: "msp430x"

// ---- SRAM ----
ram: Memory.ArrayMemory @ sysbus 0x1C00
    size: 0x2000            // 8 KB

// ---- FRAM (main) ----
code: Memory.ArrayMemory @ sysbus 0x4000
    size: 0x40000           // 256 KB (0x4000–0x43FFF)

// ---- Information memory (FRAM) ----
info_mem: Memory.ArrayMemory @ sysbus 0x1800
    size: 0x200             // 512 B

// ---- Boot ROM (BSL) ----
bsl: Memory.ArrayMemory @ sysbus 0x1000
    size: 0x800

// ---- Watchdog ----
wdt: Timers.MSP430F2XXX_Watchdog @ {
    sysbus 0x15C;
    sysbus new Bus.BusMultiRegistration { address: 0x0000; size: 0x1; region: "interruptEnable" };
    sysbus new Bus.BusMultiRegistration { address: 0x0002; size: 0x1; region: "interruptStatus" }
}
    baseFrequency: 32768

// ---- Timer_A0 (5 CC channels) ----
timer_a0: Timers.MSP430_Timer @ {
    sysbus <0x340, +0x30>;
    sysbus new Bus.BusMultiRegistration { address: 0x012E; size: 0x2; region: "interruptVector" }
}
    cpu: cpu
    acknowledgeInterrupt: 6
    baseFrequency: 1_048_576
    IRQ0->cpu@6
    IRQ_IV->cpu@7

// ---- Timer_A1 (3 CC channels) ----
timer_a1: Timers.MSP430_Timer @ {
    sysbus <0x380, +0x20>;
    sysbus new Bus.BusMultiRegistration { address: 0x011E; size: 0x2; region: "interruptVector" }
}
    cpu: cpu
    acknowledgeInterrupt: 2
    baseFrequency: 1_048_576
    IRQ0->cpu@2
    IRQ_IV->cpu@3

// ---- Timer_A2 ----
timer_a2: Timers.MSP430_Timer @ {
    sysbus <0x400, +0x20>;
    sysbus new Bus.BusMultiRegistration { address: 0x011C; size: 0x2; region: "interruptVector" }
}
    cpu: cpu
    acknowledgeInterrupt: 4
    baseFrequency: 1_048_576
    IRQ0->cpu@4
    IRQ_IV->cpu@5

// ---- Timer_B0 (7 CC channels) ----
timer_b0: Timers.MSP430_Timer @ {
    sysbus <0x3C0, +0x40>;
    sysbus new Bus.BusMultiRegistration { address: 0x011A; size: 0x2; region: "interruptVector" }
}
    cpu: cpu
    acknowledgeInterrupt: 10
    baseFrequency: 1_048_576
    IRQ0->cpu@10
    IRQ_IV->cpu@11

// ---- eUSCI_A0 (UART) ----
usci_a0: UART.MSP430_eUSCI @ sysbus 0x5C0
    -> cpu@12

// ---- eUSCI_A1 (UART) ----
usci_a1: UART.MSP430_eUSCI @ sysbus 0x600
    -> cpu@13

// ---- eUSCI_A2 (UART) ----
usci_a2: UART.MSP430_eUSCI @ sysbus 0x640
    -> cpu@14

// ---- eUSCI_A3 (UART) ----
usci_a3: UART.MSP430_eUSCI @ sysbus 0x680
    -> cpu@15

// ---- Hardware Multiplier (32-bit) ----
mpy: Miscellaneous.MSP430F2XXX_MPY @ sysbus <0x4C0, +0x10>
