// MSPM0C1104 platform description
// Texas Instruments MSPM0C1104 — Cortex-M0+ @ 24 MHz
// 16 KB Flash, 1 KB SRAM
// MSPM0C series — ultra-low-cost, 8-pin / 20-pin packages
// Drop-in replacement for legacy 8-bit MCUs
// Reference: SLAU907, MSPM0 C-Series Technical Reference Manual

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic
    init:
        PerformanceInMips 24

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 24000000
    -> cpu@0

// ---- Memory ----
flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x4000            // 16 KB

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x400             // 1 KB

// ---- UART (1 instance) ----
uart0: UART.PL011 @ sysbus 0x40108000
    -> nvic@15

// ---- I2C (1 instance) ----
i2c0: I2C.STM32F7_I2C @ sysbus 0x400F0000
    EventInterrupt -> nvic@0

// ---- SPI (1 instance) ----
spi0: SPI.STM32SPI @ sysbus 0x40468000
    IRQ -> nvic@1

// ---- Timer ----
timer0: Timers.STM32_Timer @ sysbus 0x40860000
    frequency: 24000000
    initialLimit: 0xFFFF
    -> nvic@4

timer1: Timers.STM32_Timer @ sysbus 0x40862000
    frequency: 24000000
    initialLimit: 0xFFFF
    -> nvic@5

// ---- GPIO ----
gpioA: GPIOPort.STM32_GPIOPort @ sysbus <0x400A0000, +0x100>
    numberOfAFs: 16
    [0-31] -> nvic@8

sysbus:
    init:
        Tag <0x40420000 0x2000> "SYSCTL"
        Tag <0x40500000 0x4000> "ADC0"
        Tag <0x40080000 0x2000> "WWDT0"
        Tag <0x40800000 0x2000> "DMA"
