// MSP430FR2355 platform description
// Texas Instruments MSP430FR2355 — MSP430 (16/20-bit), 24 MHz
// 64 KB FRAM, 4 KB SRAM, enhanced comparator, SAC (smart analog combo)
// Reference: SLASEC4, MSP430FR2355 Datasheet
//
// Memory map:
//   0x2000–0x2FFF  SRAM (4 KB)
//   0x8000–0x17FFF FRAM (64 KB)
//   0x1800–0x19FF  Information FRAM (512 B)

cpu: CPU.MSP430X @ sysbus
    cpuType: "msp430x"

// ---- SRAM ----
ram: Memory.ArrayMemory @ sysbus 0x2000
    size: 0x1000            // 4 KB

// ---- FRAM (main) ----
code: Memory.ArrayMemory @ sysbus 0x8000
    size: 0x10000           // 64 KB

// ---- Information memory ----
info_mem: Memory.ArrayMemory @ sysbus 0x1800
    size: 0x200

// ---- BSL ----
bsl: Memory.ArrayMemory @ sysbus 0x1000
    size: 0x800

// ---- Watchdog ----
wdt: Timers.MSP430F2XXX_Watchdog @ {
    sysbus 0x15C;
    sysbus new Bus.BusMultiRegistration { address: 0x0000; size: 0x1; region: "interruptEnable" };
    sysbus new Bus.BusMultiRegistration { address: 0x0002; size: 0x1; region: "interruptStatus" }
}
    baseFrequency: 32768

// ---- Timer_A0 ----
timer_a0: Timers.MSP430_Timer @ {
    sysbus <0x380, +0x20>;
    sysbus new Bus.BusMultiRegistration { address: 0x012E; size: 0x2; region: "interruptVector" }
}
    cpu: cpu
    acknowledgeInterrupt: 6
    baseFrequency: 1_048_576
    IRQ0->cpu@6
    IRQ_IV->cpu@7

// ---- Timer_A1 ----
timer_a1: Timers.MSP430_Timer @ {
    sysbus <0x3C0, +0x20>;
    sysbus new Bus.BusMultiRegistration { address: 0x011E; size: 0x2; region: "interruptVector" }
}
    cpu: cpu
    acknowledgeInterrupt: 2
    baseFrequency: 1_048_576
    IRQ0->cpu@2
    IRQ_IV->cpu@3

// ---- Timer_B0 ----
timer_b0: Timers.MSP430_Timer @ {
    sysbus <0x400, +0x40>;
    sysbus new Bus.BusMultiRegistration { address: 0x011C; size: 0x2; region: "interruptVector" }
}
    cpu: cpu
    acknowledgeInterrupt: 4
    baseFrequency: 1_048_576
    IRQ0->cpu@4
    IRQ_IV->cpu@5

// ---- eUSCI_A0 (UART) ----
usci_a0: UART.MSP430_eUSCI @ sysbus 0x500
    -> cpu@12

// ---- eUSCI_A1 (UART) ----
usci_a1: UART.MSP430_eUSCI @ sysbus 0x540
    -> cpu@13

// ---- Hardware Multiplier ----
mpy: Miscellaneous.MSP430F2XXX_MPY @ sysbus <0x4C0, +0x10>
