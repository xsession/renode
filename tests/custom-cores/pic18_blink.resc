:name: PIC18 Blink
:description: Minimal blink loop on PIC18 — writes to access-bank file register 0x10

using sysbus
mach create "pic18-blink"
machine LoadPlatformDescription @tests/custom-cores/pic18_blink.repl

macro reset
"""
    sysbus LoadBinary @tests/custom-cores/blink_pic18.bin 0x000000
    cpu PC 0x000000
"""

runMacro $reset
