:name: PIC16 Blink
:description: Minimal blink loop on PIC16 — writes PORTB (file register 0x06)

using sysbus
mach create "pic16-blink"
machine LoadPlatformDescription @tests/custom-cores/pic16_blink.repl

macro reset
"""
    sysbus LoadBinary @tests/custom-cores/blink_pic16.bin 0x000000
    cpu PC 0x000000
"""

runMacro $reset
